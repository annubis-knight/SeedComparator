{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./app/*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"],
      "#shared/*": ["./shared/*"],
      "#shared": ["./shared/contracts.ts"]
    }
  },
  "include": [
    "app/**/*",
    "shared/**/*",
    "electron/**/*",
    "scripts/**/*",
    "prisma/seed.ts",
    "nuxt.config.ts"
  ],
  "exclude": ["node_modules", ".output", "dist", "dist-electron", "tests", "server", ".nuxt"]
}
