# Copie ce fichier en .env (ou .env.local) et remplis les valeurs.
# .env / .env.local ne sont PAS commités.

# PostgreSQL — adapter à ton install locale
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/seedcomparator?schema=public"

# EPIC-14 — Mode provider initial au boot.
# Valeurs possibles : mock | mock-real | live
#  - mock      : données fictives (PNG placeholder, rawResponse synthétique). Aucun appel API.
#  - mock-real : rejoue les fixtures capturées depuis /models/test (vraies réponses providers).
#  - live      : appels API réels (paiement à chaque génération).
# Surchargeable runtime depuis Réglages (persisté en DB).
PROVIDER_MODE="live"

# Compat ascendante — ancienne variable booléenne, équivaut à PROVIDER_MODE="mock".
# Laisser à "false" si PROVIDER_MODE est défini.
PROVIDERS_MOCK_MODE="false"

# Clés API providers — chargées automatiquement au boot Nitro vers `apiKeys` en mémoire.
# Naming : <PROVIDER_ID_SCREAMING_SNAKE>_API_KEY (le providerId est celui de la table DB Provider).
# Mapping : openai → OPENAI_API_KEY · openrouter → OPENROUTER_API_KEY ·
#           fal → FAL_API_KEY · google-ai → GOOGLE_AI_API_KEY
# Cascade : env au boot → UI Réglages override runtime.
# Pour la prod Electron, les clés sont chiffrées via safeStorage et ces variables
# ne sont pas requises. Pour le dev local, mets-les ici.
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
FAL_API_KEY=""
GOOGLE_AI_API_KEY=""
