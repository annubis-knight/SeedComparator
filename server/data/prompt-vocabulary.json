  "brand_values_visual_translation": {
    "_group": "7_mood_matter_color",
    "_subgroup": "Brand values → visual",
    "_phaseAffinity": ["mood", "uiux"],
    "_description": "Pont sémantique entre valeurs de marque (abstraites) et leurs traductions visuelles concrètes. Le LLM utilise ces correspondances pour traduire les valeurs fournies par l'utilisateur en éléments graphiques exploitables (formes, lumière, palette, matières) au lieu de tomber dans le cliché statistique (cadenas pour la sécurité, etc.).",
    "terms": [
      "trust → symmetric composition, deep navy and brass tones, grounded geometry",
      "stability → monolithic blocks, heavy footed forms, stone textures",
      "innovation → asymmetric layout, refracted glass, neon accent on neutral base",
      "agility → fluid curves, light translucency, motion suggestion",
      "eco-responsibility → organic curves, earth tones, paper and wood textures",
      "sustainability → muted greens, recycled paper texture, restrained palette",
      "luxury → ultra-thin typography, deep negative space, subtle gold accent",
      "exclusivity → restrained palette, oversized white space, single hero element",
      "performance → motion blur, sharp diagonal lines, high contrast",
      "speed → directional motion blur, accelerated perspective, kinetic type",
      "transparency → layered translucent glass, hairline strokes, frosted depth",
      "clarity → high contrast typography, white background, ample spacing",
      "craftsmanship → matte materials, careful hand-set type, restrained color",
      "rigor → mathematical grid, monospaced type, clinical lighting",
      "warmth → soft window light, terracotta and cream palette, rounded forms",
      "empathy → soft gradients, organic shapes, warm pastel palette",
      "boldness → oversized display type, saturated primary, hard edges",
      "calm → muted palette, slow visual rhythm, large negative space",
      "playfulness → mixed scales, unexpected color juxtapositions, irregular forms",
      "expertise → editorial serif, structured grid, deep tonal palette",
      "modernity → glassmorphism, refined sans-serif, ambient occlusion",
      "tradition → editorial serif, classical proportions, muted heritage palette",
      "freedom → broken grid, organic flow, expansive negative space",
      "security → grounded symmetry, deep tones, weighty geometric forms"
    ]
  },

