{
  "name": "seedcomparator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comparateur multi-providers d'IA générative d'images pour hero sections",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "npm run kill:ports && concurrently -k -n nuxt,electron -c blue,magenta \"npm run nuxt:dev\" \"wait-on http://127.0.0.1:3300 && electron-vite dev\"",
    "build": "electron-vite build && nuxt build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "nuxt:dev": "nuxt dev --port 3300",
    "nuxt:build": "nuxt build",
    "kill:ports": "node scripts/kill-ports.mjs 3300 5300",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "nuxt prepare && tsc --noEmit -p tsconfig.server.json",
    "typecheck:full": "nuxt prepare && nuxi typecheck && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "probe:openai": "node scripts/probe-providers/probe-openai.mjs",
    "probe:google-ai": "node scripts/probe-providers/probe-google-ai.mjs",
    "probe:fal": "node scripts/probe-providers/probe-fal.mjs",
    "probe:openrouter": "node scripts/probe-providers/probe-openrouter.mjs",
    "probe:all": "node scripts/probe-providers/probe-all.mjs",
    "probe:dry-run": "node scripts/probe-providers/probe-all.mjs --dry-run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "node-vibrant": "^4.0.4",
    "p-limit": "^6.1.0",
    "playwright": "^1.59.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.14.4",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^10.9.0",
    "happy-dom": "^15.11.6",
    "nuxt": "^3.14.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.1",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.1.10",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
